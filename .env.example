APP_NAME=Finance Agent
ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://finance_agent:finance_agent@localhost:5432/finance_agent

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_PROXY_URL=

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=deepseek-chat

# Hybrid metadata retrieval (start Milvus with docker compose up -d)
RETRIEVER_MODE=legacy
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=finance_metadata_hybrid_v1
ZHIPU_API_KEY=
ZHIPU_RETRIEVAL_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=1024
ZHIPU_RERANK_MODEL=rerank
ENABLE_RERANKER=true
RETRIEVAL_BM25_TOP_K=30
RETRIEVAL_DENSE_TOP_K=30
RERANK_TOP_N=30
FINAL_TOP_K=16

# Phase 3 Context Engine: estimated metadata-prompt tokens, not model-billed tokens.
SCHEMA_CONTEXT_BUDGET=10000
STAGE_RETRIEVAL_BUDGET=2
GLOBAL_RETRIEVAL_BUDGET=3

MAX_RETRY=2
SQL_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=1000
RESULT_PREVIEW_ROWS=100
EXPORT_MAX_ROWS=100000
EXPORT_TIMEOUT_SECONDS=60

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
